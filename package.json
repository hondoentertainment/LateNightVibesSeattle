{
  "name": "late-night-vibes-seattle",
  "version": "1.0.0",
  "private": true,
  "description": "Discover nightlife venues open after 9 PM",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint *.js lib/*.js",
    "lint:fix": "eslint --fix *.js lib/*.js",
    "optimize:images": "node scripts/optimize-images.mjs",
    "generate:splash": "node scripts/generate-splash.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:desktop": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:all": "npm run test && npm run test:e2e",
    "validate": "node scripts/validate-venues.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "eslint": "^9.0.0",
    "serve": "^14.2.5",
    "sharp": "^0.34.5",
    "vitest": "^3.0.0"
  }
}
